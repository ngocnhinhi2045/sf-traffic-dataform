config {
    type: "table",
    schema: "sf_traffic_gold",
    name: "dim_neighborhood",
    description: "Neighborhood Dimension",
    tags: ["gold", "dimension"],
    assertions: {
        uniqueKey: ["neighborhood_key"],
        nonNull: ["neighborhood_key", "neighborhood_id"]
    }
}

WITH source AS (
    SELECT *
    FROM ${ref("slv_neighborhood")}
),
cleaned AS (
    SELECT
        neighborhood_id,
        neighborhood_name,
        geography
    FROM source
    WHERE neighborhood_id IS NOT NULL
    -- Loại bỏ trùng lặp an toàn thay cho DISTINCT
    QUALIFY ROW_NUMBER() OVER(
        PARTITION BY neighborhood_id 
        ORDER BY neighborhood_name
    ) = 1
),
final AS (
    SELECT
        ROW_NUMBER() OVER(ORDER BY neighborhood_name) AS neighborhood_key,
        *
    FROM cleaned
)
SELECT * FROM final