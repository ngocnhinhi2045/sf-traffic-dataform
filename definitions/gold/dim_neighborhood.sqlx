config {
    type: "table",
    schema: "sf_traffic_gold",
    name: "dim_neighborhood",
    description: "Neighborhood Dimension (Sử dụng FARM_FINGERPRINT làm Surrogate Key an toàn)",
    tags: ["gold", "dimension"],
    assertions: {
        uniqueKey: ["neighborhood_key"],
        nonNull: ["neighborhood_key", "neighborhood_id"]
    }
}

WITH source AS (
    SELECT *
    FROM ${ref("slv_neighborhood")}
),
cleaned AS (
    SELECT
        neighborhood_id,
        neighborhood_name,
        geography
    FROM source
    WHERE neighborhood_id IS NOT NULL
    QUALIFY ROW_NUMBER() OVER(
        PARTITION BY neighborhood_id 
        ORDER BY neighborhood_name
    ) = 1
),
final AS (
    SELECT
        -- Tạo Surrogate Key ổn định chống trôi khi incremental load
        CAST(ABS(FARM_FINGERPRINT(CAST(neighborhood_id AS STRING))) AS INT64) AS neighborhood_key,
        neighborhood_id,
        neighborhood_name,
        geography
    FROM cleaned
)
SELECT * FROM final