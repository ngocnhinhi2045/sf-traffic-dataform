config {
    type: "table",
    schema: "sf_traffic_mart",
    name: "mart_incident_response",
    description: "Incident Response Mart: Hợp nhất Sự cố và Khu vực thi công phục vụ bản đồ điều hành thời gian thực",
    tags: ["mart", "incident", "work_zone", "realtime"],
    bigquery: {
        partitionBy: "DATE(event_timestamp)",
        clusterBy: ["event_category", "event_status", "neighborhood_name"]
    }
}

WITH 
--------------------------------------------------------------------------------
-- 1. Lấy dữ liệu Sự cố (Incidents)
--------------------------------------------------------------------------------
incident_data AS (
    SELECT 
        'Incident' AS event_category,
        incident_id AS event_id,
        location_key,
        neighborhood_key,
        camera_key,
        updated AS event_timestamp,
        event_type,
        status AS event_status,
        severity AS impact_level,
        headline AS description,
        roads_direction AS direction, -- Giữ lại hướng di chuyển
        geography
    FROM ${ref("fact_traffic_incident")}
),

--------------------------------------------------------------------------------
-- 2. Lấy dữ liệu Khu vực thi công (Work Zones)
--------------------------------------------------------------------------------
work_zone_data AS (
    SELECT 
        'Work Zone' AS event_category,
        work_zone_id AS event_id,
        location_key,
        neighborhood_key,
        CAST(NULL AS INT64) AS camera_key, 
        start_date AS event_timestamp,
        event_type,
        event_status,
        vehicle_impact AS impact_level,
        description,
        direction,
        geography
    FROM ${ref("fact_work_zone")}
),

--------------------------------------------------------------------------------
-- 3. Hợp nhất hai luồng dữ liệu (UNION ALL)
--------------------------------------------------------------------------------
combined_events AS (
    SELECT * FROM incident_data
    UNION ALL
    SELECT * FROM work_zone_data
)

--------------------------------------------------------------------------------
-- 4. Trải phẳng với các Dimension (Flattening)
--------------------------------------------------------------------------------
SELECT
    -- Phân loại và Định danh
    e.event_category,
    e.event_id,
    e.event_timestamp,
    
    -- Chi tiết sự kiện
    e.event_type,
    e.event_status,
    e.impact_level,
    e.description,
    e.direction,
    
    -- Thông tin địa lý & Phân vùng (Lấy tên đường từ bảng Dimension)
    l.street_name,     -- Đã sửa: Kéo tên đường chuẩn từ Dim Location
    l.street_class,
    n.neighborhood_name,
    l.zip_code,
    
    -- Thông tin Camera (Cực kỳ quan trọng cho điều hành Real-time)
    COALESCE(e.camera_key, cam.camera_key) AS matched_camera_key,
    CASE 
        WHEN e.camera_key IS NOT NULL THEN TRUE 
        WHEN l.has_camera = TRUE THEN TRUE 
        ELSE FALSE 
    END AS is_camera_available,
    cam.streaming_video_url, 
    
    -- GIS Không gian (Để cắm pin lên bản đồ)
    e.geography

FROM combined_events e
LEFT JOIN ${ref("dim_location_street")} l ON e.location_key = l.location_key
LEFT JOIN ${ref("dim_neighborhood")} n ON e.neighborhood_key = n.neighborhood_key
LEFT JOIN ${ref("dim_camera")} cam ON e.camera_key = cam.camera_key