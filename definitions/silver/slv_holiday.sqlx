config {
    type: "table",
    schema: "sf_traffic_silver",
    name: "slv_holiday",
    description: "Silver layer - Standardized holiday dataset (CSV Source)",
    tags: ["silver", "holiday", "dimension"],
    columns: {
        holiday_date: "Holiday date",
        holiday_name: "Holiday name",
        country_code: "Country code",
        holiday_types: "Holiday types",
        subdivision_codes: "Subdivision codes",
        geography_scope: "Global/National holiday flag"
    },
    assertions: {
        nonNull: ["holiday_date", "holiday_name", "country_code"],
        uniqueKey: ["country_code", "holiday_date", "holiday_name"]
    },
    bigquery: {
        partitionBy: "holiday_date",
        clusterBy: ["country_code"]
    }
}

--------------------------------------------------------------------------------
-- Stage 1 : Source
--------------------------------------------------------------------------------
WITH source AS (
    SELECT *
    FROM ${ref("ext_holiday")}
),

--------------------------------------------------------------------------------
-- Stage 2 : Schema Standardization (Đọc từ cột CSV, xuất ra chuẩn chung)
--------------------------------------------------------------------------------
standardized AS (
    SELECT
        SAFE_CAST(date AS DATE) AS holiday_date,
        TRIM(CAST(name AS STRING)) AS holiday_name,
        TRIM(CAST(countryCode AS STRING)) AS country_code,
        ARRAY_TO_STRING(holidayTypes, ', ') AS holiday_types,
        ARRAY_TO_STRING(subdivisionCodes, ', ') AS subdivision_codes,
        CASE 
            WHEN UPPER(TRIM(CAST(nationalHoliday AS STRING))) IN ('TRUE', '1', 'YES') THEN TRUE 
            ELSE FALSE 
        END AS geography_scope
    FROM source
),

--------------------------------------------------------------------------------
-- Stage 3 : Data Cleansing
--------------------------------------------------------------------------------
cleaned AS (
    SELECT *
    FROM standardized
    WHERE
        holiday_date IS NOT NULL
        AND holiday_name IS NOT NULL
),

--------------------------------------------------------------------------------
-- Stage 4 : Data Transformation
--------------------------------------------------------------------------------
transformed AS (
    SELECT *
    FROM cleaned
),

--------------------------------------------------------------------------------
-- Stage 5 : Data Quality Validation
--------------------------------------------------------------------------------
validated AS (
    SELECT *
    FROM transformed
    WHERE country_code IS NOT NULL
),

--------------------------------------------------------------------------------
-- Stage 6 : Deduplication 
--------------------------------------------------------------------------------
deduplicated AS (
    SELECT *
    FROM validated
    QUALIFY ROW_NUMBER() OVER(
        PARTITION BY country_code, holiday_date, holiday_name 
        ORDER BY holiday_date
    ) = 1
),

--------------------------------------------------------------------------------
-- Stage 7 : Publish (Gắn metadata)
--------------------------------------------------------------------------------
final AS (
    SELECT 
        holiday_date,
        holiday_name,
        country_code,
        holiday_types,
        subdivision_codes,
        geography_scope,
        CURRENT_TIMESTAMP() AS _etl_loaded_at,
        "ext_holiday_csv" AS _source_system,
        "Silver" AS _layer,
        "1.1" AS _pipeline_version
    FROM deduplicated
)

SELECT * FROM final